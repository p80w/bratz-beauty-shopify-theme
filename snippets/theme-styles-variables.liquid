{% render 'bratz-font' %}

{% style %}

  :root {
    /* Page Layout */
    --sidebar-width: 40rem;
    --theme-drawer-width: 48rem;
    --narrow-content-width: 57.6rem;
    --normal-content-width: 67.2rem;
    --narrow-page-width: 144rem;
    --normal-page-width: 192rem;
    --wide-page-width: 240rem;

    /* Section Heights */
    --section-height-small: 24rem;
    --section-height-medium: 40rem;
    --section-height-large: 56rem;

    @media screen and (min-width: 40em) {
      --section-height-small: 40svh;
      --section-height-medium: 55svh;
      --section-height-large: 70svh;
    }

    @media screen and (min-width: 60em) {
      --section-height-small: 50svh;
      --section-height-medium: 65svh;
      --section-height-large: 80svh;
    }

    /* Letter spacing */
    --letter-spacing-sm: 0.06em;

    /* Font families */
    --font-body--family: 'Akkurat Mono LL', monospace;
    --font-body--style: normal;
    --font-body--weight: 400;
    --font-subheading--family: 'Druk', sans-serif;
    --font-subheading--style: normal;
    --font-subheading--weight: 700;
    --font-heading--family: 'Druk', sans-serif;
    --font-heading--style: normal;
    --font-heading--weight: 700;
    --font-accent--family: 'Sloop', cursive;
    --font-accent--style: normal;
    --font-accent--weight: 400;
    --font-druk-wide--family: 'Druk Wide Web', sans-serif;
    --font-druk-wide--style: normal;
    --font-druk-wide--weight: 500;

    /* Margin sizes */
    --font-heading--spacing: 0.25em;
    --font-h1--spacing: var(--font-heading--spacing);
    --font-h2--spacing: var(--font-heading--spacing);
    --font-h3--spacing: var(--font-heading--spacing);
    --font-h4--spacing: var(--font-heading--spacing);
    --font-h5--spacing: var(--font-heading--spacing);
    --font-h6--spacing: var(--font-heading--spacing);
    --font-paragraph--spacing: 0.5em;

    /** Z-Index / Layering */
    --layer-section-background: -2;
    --layer-lowest: -1;
    --layer-base: 0;
    --layer-flat: 1;
    --layer-raised: 2;
    --layer-heightened: 4;
    --layer-sticky: 8;
    --layer-window-overlay: 10;
    --layer-header-menu: 12;
    --layer-overlay: 16;
    --layer-menu-drawer: 18;
    --layer-temporary: 20;

    /* Max-width / Measure */
    --max-width--body-normal: 32.5em;
    --max-width--body-narrow: 22.75em;

    --max-width--heading-normal: 32.5em;
    --max-width--heading-narrow: 19.5em;

    --max-width--display-normal: 13em;
    --max-width--display-narrow: 9.75em;
    --max-width--display-tight: 3.25em;

    /* Letter-spacing / Tracking */
    --letter-spacing--display-tight: -0.03em;
    --letter-spacing--display-normal: 0em;
    --letter-spacing--display-loose: 0.03em;

    --letter-spacing--heading-tight: -0.03em;
    --letter-spacing--heading-normal: 0em;
    --letter-spacing--heading-loose: 0.03em;

    --letter-spacing--body-tight: -0.03em;
    --letter-spacing--body-normal: 0em;
    --letter-spacing--body-loose: 0.03em;

    /* Line height / Leading */
    --line-height: 1;

    --line-height--display-tight: 1;
    --line-height--display-normal: 1.1;
    --line-height--display-loose: 1.2;

    --line-height--heading-tight: 1.15;
    --line-height--heading-normal: 1.25;
    --line-height--heading-loose: 1.35;

    --line-height--body-tight: 1.2;
    --line-height--body-normal: 1.4;
    --line-height--body-loose: 1.6;

    /* Typography presets */
    {% liquid
      assign type_presets = "paragraph, tagline, paragraph-large, paragraph-small, paragraph-extrasmall, tagline-large, tagline-small, h1, h2, h3, h4, h5, h6" | split: ", "
      for preset_name in type_presets

        if preset_name == 'h1'
          assign preset_size_rem = 12.0
          assign preset_mobile_size_rem = 4.0

          assign preset_line_height_rem = 11.0
          assign preset_mobile_line_height_rem = 3.6

          assign preset_font = '--font-heading--family'
          assign preset_style = '--font-heading--style'
          assign preset_weight = '--font-heading--weight'

        elsif preset_name == 'h2'
          assign preset_size_rem = 4.8
          assign preset_mobile_size_rem = 3.0

          assign preset_line_height_rem = 4.0
          assign preset_mobile_line_height_rem = 2.6

          assign preset_font = '--font-heading--family'
          assign preset_style = '--font-heading--style'
          assign preset_weight = '--font-heading--weight'

        elsif preset_name == 'h3'
          assign preset_size_rem = 4.0
          assign preset_mobile_size_rem = 2.4

          assign preset_line_height_rem = 3.6
          assign preset_mobile_line_height_rem = 2.0

          assign preset_font = '--font-heading--family'
          assign preset_style = '--font-heading--style'
          assign preset_weight = '--font-heading--weight'

        elsif preset_name == 'h4'
          assign preset_size_rem = 2.4
          assign preset_mobile_size_rem = 1.6

          assign preset_line_height_rem = 2.2
          assign preset_mobile_line_height_rem = 1.4

          assign preset_font = '--font-heading--family'
          assign preset_style = '--font-heading--style'
          assign preset_weight = '--font-heading--weight'

        elsif preset_name == 'h5'
          assign preset_size_rem = 1.8
          assign preset_mobile_size_rem = 1.4

          assign preset_line_height_rem = 1.6
          assign preset_mobile_line_height_rem = 1.2

          assign preset_font = '--font-heading--family'
          assign preset_style = '--font-heading--style'
          assign preset_weight = '--font-heading--weight'

        elsif preset_name == 'h6'
          assign preset_size_rem = 1.6
          assign preset_mobile_size_rem = 1.2

          assign preset_line_height_rem = 1.4
          assign preset_mobile_line_height_rem = 1.2

          assign preset_font = '--font-heading--family'
          assign preset_style = '--font-heading--style'
          assign preset_weight = '--font-heading--weight'

        elsif preset_name == 'tagline-large'
          assign preset_size_rem = 1.6
          assign preset_mobile_size_rem = 1.6

          assign preset_line_height_rem = 1.6
          assign preset_mobile_line_height_rem = 1.6

          assign preset_font = '--font-body--family'
          assign preset_style = '--font-body--style'
          assign preset_weight = '--font-body--weight'

        elsif preset_name == 'tagline-regular'
          assign preset_size_rem = 1.4
          assign preset_mobile_size_rem = 1.4

          assign preset_line_height_rem = 1.4
          assign preset_mobile_line_height_rem = 1.4

          assign preset_font = '--font-body--family'
          assign preset_style = '--font-body--style'
          assign preset_weight = '--font-body--weight'

        elsif preset_name == 'tagline-small'
          assign preset_size_rem = 1.2
          assign preset_mobile_size_rem = 1.2

          assign preset_line_height_rem = 1.2
          assign preset_mobile_line_height_rem = 1.2

          assign preset_font = '--font-body--family'
          assign preset_style = '--font-body--style'
          assign preset_weight = '--font-body--weight'

        elsif preset_name == 'paragraph'
          assign preset_size_rem = 1.6
          assign preset_mobile_size_rem = 1.6

          assign preset_line_height_rem = 2.4
          assign preset_mobile_line_height_rem = 2.4

          assign preset_font = '--font-body--family'
          assign preset_style = '--font-body--style'
          assign preset_weight = '--font-body--weight'

        elsif preset_name == 'paragraph-large'
          assign preset_size_rem = 1.8
          assign preset_mobile_size_rem = 1.8

          assign preset_line_height_rem = 2.6
          assign preset_mobile_line_height_rem = 2.6

          assign preset_font = '--font-body--family'
          assign preset_style = '--font-body--style'
          assign preset_weight = '--font-body--weight'

        elsif preset_name == 'paragraph-small'
          assign preset_size_rem = 1.4
          assign preset_mobile_size_rem = 1.4

          assign preset_line_height_rem = 2.0
          assign preset_mobile_line_height_rem = 2.0

          assign preset_font = '--font-body--family'
          assign preset_style = '--font-body--style'
          assign preset_weight = '--font-body--weight'

        elsif preset_name == 'paragraph-extrasmall'
          assign preset_size_rem = 1.2
          assign preset_mobile_size_rem = 1.2

          assign preset_line_height_rem = 1.6
          assign preset_mobile_line_height_rem = 1.6

          assign preset_font = '--font-body--family'
          assign preset_style = '--font-body--style'
          assign preset_weight = '--font-body--weight'
        endif

        echo '--font-size--[preset_name]: [preset_size_rem]rem;' | replace: '[preset_name]', preset_name | replace: '[preset_size_rem]', preset_size_rem

        echo '--font-[preset_name]--size: var(--font-size--[preset_name]);' | replace: '[preset_name]', preset_name

        echo '--font-[preset_name]--size-mobile: [preset_mobile_size_rem]rem;' | replace: '[preset_name]', preset_name | replace: '[preset_mobile_size_rem]', preset_mobile_size_rem

        echo '--font-[preset_name]--line-height: [preset_line_height_rem]rem;' | replace: '[preset_name]', preset_name | replace: '[preset_line_height_rem]', preset_line_height_rem

        echo '--font-[preset_name]--line-height-mobile: [preset_mobile_line_height_rem]rem;' | replace: '[preset_name]', preset_name | replace: '[preset_mobile_line_height_rem]', preset_mobile_line_height_rem

        echo '--font-[preset_name]--family: var([preset_font]);' | replace: '[preset_name]', preset_name | replace: '[preset_font]', preset_font

        echo '--font-[preset_name]--style: var([preset_style]);' | replace: '[preset_name]', preset_name | replace: '[preset_style]', preset_style

        echo '--font-[preset_name]--weight: var([preset_weight]);' | replace: '[preset_name]', preset_name | replace: '[preset_weight]', preset_weight

        echo '--font-[preset_name]--case: {{ settings.heading_text_case }};' | replace: '[preset_name]', preset_name
      endfor
    %}

    /* Hardcoded font sizes */
    --font-size--3xs: 1rem;
    --font-size--2xs: 1.2rem;
    --font-size--xs: 1.3rem;
    --font-size--sm: 1.4rem;
    --font-size--md: 1.6rem;
    --font-size--lg: 1.8rem;
    --font-size--xl: 2rem;
    --font-size--2xl: 2.4rem;
    --font-size--3xl: 3.2rem;
    --font-size--4xl: 4rem;
    --font-size--5xl: 4.8rem;
    --font-size--6xl: 5.6rem;

    --font-h1--letter-spacing: normal;
    --font-h2--letter-spacing: normal;
    --font-h3--letter-spacing: normal;
    --font-h4--letter-spacing: normal;
    --font-h5--letter-spacing: normal;
    --font-h6--letter-spacing: normal;

    --font-h1--case: uppercase;
    --font-h2--case: uppercase;
    --font-h3--case: uppercase;
    --font-h4--case: uppercase;
    --font-h5--case: uppercase;
    --font-h6--case: uppercase;

    --color: var(--color-foreground);

    /* Menu font sizes */
    --menu-font-sm--size: 1.4rem;
    --menu-font-sm--line-height: calc(1.1 + 0.5 * min(16 / 14));
    --menu-font-md--size: 1.6rem;
    --menu-font-md--line-height: calc(1.1 + 0.5 * min(16 / 16));
    --menu-font-xl--size: 2rem;
    --menu-font-xl--line-height: calc(1.1 + 0.5 * min(16 / 20));
    --menu-font-2xl--size: 2.8rem;
    --menu-font-2xl--line-height: calc(1.1 + 0.5 * min(16 / 28));

    /* Colors */

    /* Primary */
    --color-drama-queen: #96245E;
    --color-not-pink-punk: #F86EFC;
    --color-angel: #C690FF;
    --color-kool-kat: #000000;
    --color-bunny-boo: #F2F2F2;
    --color-white: #FFFFFF;
    --color-white-rgb: 255 255 255;

    /* Notification */
    --color-error: #FF0059;
    --color-attention: #D9FF00;
    --color-success: #00FF84;

    /* Existing Horizon stock colors */
    --color-instock: #3ED660;
    --color-lowstock: #EE9441;
    --color-outofstock: #C8C8C8;

    /* Opacity */
    --opacity-5: 0.05;
    --opacity-8: 0.08;
    --opacity-10: 0.1;
    --opacity-15: 0.15;
    --opacity-20: 0.2;
    --opacity-25: 0.25;
    --opacity-30: 0.3;
    --opacity-40: 0.4;
    --opacity-50: 0.5;
    --opacity-60: 0.6;
    --opacity-70: 0.7;
    --opacity-80: 0.8;
    --opacity-85: 0.85;
    --opacity-90: 0.9;
    --opacity-subdued-text: 0.8;
    --opacity-muted-text: 0.6;

    --shadow-button: 0 2px 3px rgb(0 0 0 / 20%);
    --gradient-image-overlay: linear-gradient(to top, rgb(0 0 0 / 0.5), transparent);

    /* Spacing */
    --margin-3xs: 0.2rem;
    --margin-2xs: 0.48rem;
    --margin-xs: 0.8rem;
    --margin-sm: 1.12rem;
    --margin-md: 1.28rem;
    --margin-lg: 1.6rem;
    --margin-xl: 2rem;
    --margin-2xl: 2.4rem;
    --margin-4xl: 3.2rem;
    --margin-6xl: 8rem;


    --padding-3xs: 0.2rem;
    --padding-2xs: 0.4rem;
    --padding-xs: 0.8rem;
    --padding-sm: 1.12rem;
    --padding-md: 1.28rem;
    --padding-lg: 1.6rem;
    --padding-xl: 2rem;
    --padding-2xl: 2.4rem;
    --padding-3xl: 2.8rem;
    --padding-4xl: 3.2rem;
    --padding-5xl: 4.8rem;
    --padding-6xl: 6.4rem;

    --gap-3xs: 0.2rem;
    --gap-2xs: 0.48rem;
    --gap-xs: 0.8rem;
    --gap-sm: 1.12rem;
    --gap-md: 1.44rem;
    --gap-lg: 1.6rem;
    --gap-xl: 2rem;
    --gap-2xl: 3.2rem;
    --gap-3xl: 4.8rem;

    --spacing-scale-md: 0.7;
    --spacing-scale-default: 1.0;

    /* Checkout buttons gap */
    --checkout-button-gap: 10px;

    /* Borders */
    --style-border-width: 1px;
    --style-border-radius-xs: 0.32rem;
    --style-border-radius-sm: 0.96rem;
    --style-border-radius-md: 1.28rem;
    --style-border-radius-50: 50%;
    --style-border-radius-lg: 1.6rem;
    --style-border-radius-pills: {{ settings.pills_border_radius }}px;
    --style-border-radius-inputs: {{ settings.inputs_border_radius }}px;
    --style-border-radius-buttons-primary: {{ settings.button_border_radius_primary }}px;
    --style-border-radius-buttons-secondary: {{ settings.button_border_radius_secondary }}px;
    --style-border-width-primary: {{ settings.primary_button_border_width }}px;
    --style-border-width-secondary: {{ settings.secondary_button_border_width }}px;
    --style-border-width-inputs: {{ settings.input_border_width }}px;
    --style-border-radius-popover: {{ settings.popover_border_radius }}px;
    --style-border-popover: {{ settings.popover_border_width }}px solid {{ settings.popover_border_color }};
    --style-border-drawer: 1px solid {{ settings.drawer_border_color }};
    --style-border-swatch-opacity: {{ settings.variant_swatch_border_opacity }}%;
    --style-border-swatch-width: {{ settings.variant_swatch_border_width }}px;
    --style-border-swatch-style: {{ settings.variant_swatch_border_style }};

    /* Animation */
    --ease-out-cubic: cubic-bezier(0.33, 1, 0.68, 1);
    --ease-out-quad: cubic-bezier(0.32, 0.72, 0, 1);
    --animation-speed-fast: 0.0625s;
    --animation-speed: 0.125s;
    --animation-speed-slow: 0.2s;
    --animation-speed-medium: 0.15s;
    --animation-easing: ease-in-out;
    --drawer-animation-speed: 0.2s;
    --animation-values: var(--animation-speed) var(--animation-easing);
    --animation-timing-hover: cubic-bezier(0.25, 0.46, 0.45, 0.94);
    --animation-timing-active: cubic-bezier(0.5, 0, 0.75, 0);
    --animation-timing-bounce: cubic-bezier(0.34, 1.56, 0.64, 1);
    --animation-timing-default: cubic-bezier(0, 0, 0.2, 1);
    --animation-timing-fade-in: cubic-bezier(0.16, 1, 0.3, 1);
    --animation-timing-fade-out: cubic-bezier(0.4, 0, 0.2, 1);
    /* Spring definitions suffixed with perceptual duration (d<ms>) and bounce (b<%>)*/
    --spring-d300-b0-easing: linear(0, 0.0033 0.81%, 0.027 2.42%, 0.0916 4.84%, 0.4745 15.32%, 0.6422 20.97%, 0.7175, 0.7789, 0.8283 30.64%, 0.876, 0.9111 38.71%, 0.941, 0.9611 48.39%, 0.9707, 0.978 54.84%, 0.9885 62.1%, 0.9949 70.97%, 0.9982 82.26%, 0.9997 100%);
    --spring-d300-b0-duration: 0.4980s;
    --spring-d280-b0-easing: linear(0, 0.0044, 0.0164 1.85%, 0.085 4.63%, 0.4571 14.81%, 0.575 18.52%, 0.6505, 0.7148 24.07%, 0.7849, 0.8393, 0.8809 35.18%, 0.9189, 0.9453 44.44%, 0.9662, 0.9793 55.55%, 0.9894 62.95%, 0.995 71.28%, 0.9982 82.39%, 0.9997 99.98%);
    --spring-d280-b0-duration: 0.4648s;
    --spring-d220-b0-easing: linear(
      0,
      0.0093 1.37%,
      0.0696 4.12%,
      0.4667 15.09%,
      0.6322 20.58%,
      0.6986 23.32%,
      0.7793 27.44%,
      0.8219 30.18%,
      0.8721,
      0.9089 38.42%,
      0.9427,
      0.9644,
      0.978 54.88%,
      0.9881 61.74%,
      0.9944 69.97%,
      0.998 80.95%,
      0.9996 98.78%
    );
    --spring-d220-b0-duration: 0.3818s;
    --spring-d180-b0-easing: linear(0, 0.0234, 0.0805 4.48%, 0.4865 15.68%, 0.6211 20.16%, 0.7696 26.88%, 0.8064 29.12%, 0.8646, 0.9063, 0.9358, 0.9563 47.04%, 0.9757, 0.9867 60.48%, 0.9941 69.44%, 0.9979 80.64%, 0.9996 98.56%);
    --spring-d180-b0-duration: 0.2988s;

    /* View transitions */
    /* View transition old */
    --view-transition-old-main-content: var(--animation-speed) var(--animation-easing) both fadeOut;

    /* View transition new */
    --view-transition-new-main-content: var(--animation-speed) var(--animation-easing) both fadeIn, var(--animation-speed) var(--animation-easing) both slideInTopViewTransition;

    /* Focus */
    --focus-outline-width: 0.15rem;
    --focus-outline-offset: 0.2em;

    /* Badges */
    --badge-rectangle-padding-block: 1px;
    --badge-rectangle-padding-inline: 6px;
    @media screen and (min-width: 750px) {
      --badge-rectangle-padding-block: 4px;
      --badge-rectangle-padding-inline: 10px;
    }

    /* Icons */
    --icon-size-2xs: 0.96rem;
    --icon-size-xs: 1.36rem;
    --icon-size-sm: 2rem;
    --icon-size-md: 2.2rem;
    --icon-size-lg: 2.4rem;
    --icon-stroke-width: {% if settings.icon_stroke == 'thin' %}1px{% elsif settings.icon_stroke == 'heavy' %}2px{% else %}1.5px{% endif %};

    /* Input */
    --input-padding-y: 1.28rem;
    --input-padding-x: 1.28rem;
    --input-padding: var(--input-padding-y) var(--input-padding-x);
    --input-box-shadow-width: var(--style-border-width-inputs);
    --input-box-shadow: 0 0 0 var(--input-box-shadow-width) var(--color-input-border);
    --input-box-shadow-focus: 0 0 0 calc(var(--input-box-shadow-width) + 0.5px) var(--color-input-border);
    --input-disabled-background-color: rgb(var(--color-foreground-rgb) / var(--opacity-10));
    --input-disabled-border-color: rgb(var(--color-foreground-rgb) / var(--opacity-5));
    --input-disabled-text-color: rgb(var(--color-foreground-rgb) / var(--opacity-50));
    --input-textarea-min-height: 55px;

    /* Checkbox */
    --checkbox-size: 22px;
    --checkbox-border-radius: 7px;
    --checkbox-border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-35-55));
    --checkbox-label-padding: 8px;

    @media screen and (min-width: 750px) {
      --checkbox-size: 16px;
      --checkbox-border-radius: 5px;
      --checkbox-label-padding: 6px;
    }

    /* Button size */
    --button-size-md: 36px;
    --button-size: var(--minimum-touch-target);
    --button-padding-inline: 16px;
    --button-padding-block: 12px;

    /* Button font-family */
    --button-font-family-primary: 'Druk Wide Web', sans-serif;
    --button-font-family-secondary: 'Druk Wide Web', sans-serif;

    /* Button text case */
    --button-text-case-primary: {{ settings.button_text_case_primary }};
    --button-text-case-secondary: {{ settings.button_text_case_secondary }};

    /* Borders */
    --border-color: rgb(var(--color-border-rgb) / var(--opacity-50));
    --border-width-sm: 1px;
    --border-radius-sm: 0.4rem;

    /* Drawers */
    --drawer-header-desktop-top: 0rem;
    --drawer-padding: calc(var(--padding-sm) + 7px);
    --drawer-height: 100dvh;
    --drawer-width: 95vw;
    --drawer-max-width: 500px;

    /* Variant Picker Swatches */
    --variant-picker-swatch-width-unitless: {{ settings.variant_swatch_width }};
    --variant-picker-swatch-height-unitless: {{ settings.variant_swatch_height }};
    --variant-picker-swatch-width: {{ settings.variant_swatch_width | append: 'px' }};
    --variant-picker-swatch-height: {{ settings.variant_swatch_height | append: 'px' }};
    --variant-picker-swatch-radius: {{ settings.variant_swatch_radius | append: 'px' }};
    --variant-picker-border-width: {{ settings.variant_swatch_border_width | append: 'px' }};
    --variant-picker-border-style: {{ settings.variant_swatch_border_style }};
    --variant-picker-border-opacity: {{ settings.variant_swatch_border_opacity | append: '%' }};

    /* Variant Picker Buttons */
    --variant-picker-button-radius: {{ settings.variant_button_radius | append: 'px' }};
    --variant-picker-button-border-width: {{ settings.variant_button_border_width | append: 'px' }};
    --variant-option-label-color: var(--color, var(--color-foreground));

    /* Slideshow */
    --slideshow-controls-icon: 3.2rem;
    --peek-next-slide-size: 4.8rem;

    /* Utilities */
    --backdrop-opacity: 0.15;
    --backdrop-color-rgb: var(--color-shadow-rgb);
    --minimum-touch-target: 44px;
    --disabled-opacity: 0.5;
    --skeleton-opacity: 0.025;

    /* Shapes */

    /* Buy buttons */
    --height-buy-buttons: calc(var(--padding-lg) * 2 + var(--icon-size-sm));

    /* Card image width and height variables */
    --card-width-small: 16rem;

    --height-small: 16rem;

    @media screen and (min-width: 750px) {
      --height-small: 28rem;
    }

    /* Modal */
    --modal-max-height: 65dvh;
    --quick-add-modal-height: min(38.5rem, 96vh);
    --quick-add-modal-width: min(54rem, 96vw);
    --quick-add-modal-gallery-width: 38.4rem;

    /* Card styles for search */
    --card-bg-hover: rgb(var(--color-foreground-rgb) / var(--opacity-5));
    --card-border-hover: rgb(var(--color-foreground-rgb) / var(--opacity-30));
    --card-border-focus: rgb(var(--color-foreground-rgb) / var(--opacity-10));

    /* Cart */
    --cart-primary-font-family: var(--font-body--family);
    --cart-primary-font-style: var(--font-body--style);
    --cart-primary-font-weight: var(--font-body--weight);
    --cart-secondary-font-family: var(--font-{{ settings.cart_price_font }}--family);
    --cart-secondary-font-style: var(--font-{{ settings.cart_price_font }}--style);
    --cart-secondary-font-weight: var(--font-{{ settings.cart_price_font }}--weight);
  }

  .custom-color-quick-add {
    --quick-add-background: {{ settings.quick_add_background }};
    --quick-add-foreground: {{ settings.quick_add_text }};
  }
{% endstyle %}

