      "label": "Heading",

      "default": "BUILD YOUR PACK"

    },

    {

      "type": "richtext",

      "id": "description",

      "label": "Description",

      "default": "<p>Choose your favorites and build your perfect pack.</p>"

    },

    {

      "type": "text",

      "id": "button_text",

      "label": "Button text",

      "default": "ADD TO CART"

    }

  ],

  "presets": [

    {

      "name": "Build Your Pack",

      "category": "Product"

    }

  ]

}

