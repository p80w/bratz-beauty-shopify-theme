{% liquid
  assign product = closest.product
  assign product_highlight = product.metafields.p80.product_highlight.value
%}

<div class="bratz-product-info" {{ block.shopify_attributes }}>
  <div class="bratz-product-info__header">
    {% if product == blank %}
      <p class="bratz-product-info__title">
        {{ 'placeholders.product_title' | t }}
      </p>
    {% else %}
      <a
        class="bratz-product-info__title"
        href="{{ product.url }}"
      >
        {{ product.title }}
      </a>
    {% endif %}
  </div>
  {% if product_highlight != blank %}
    <div class="bratz-product-info__highlight">
      {{ product_highlight | metafield_tag }}
    </div>
  {% endif %}
  {% if product != blank %}
    <div class="bratz-product-info__price">
      {% render 'price',
        product_resource: product,
        show_unit_price: false,
        show_sale_price_first: false
      %}
    </div>
  {% endif %}
</div>

{% stylesheet %}

  .bratz-product-info {
    width: 100%;
  }

  .bratz-product-info__title {
    margin: 0;
    flex: 1 1 auto;
    min-width: 0;
    color: inherit;
    text-decoration: none;
    text-transform: uppercase;
  }

  .bratz-product-info__header {
    font-family: var(--font-heading--family);
    font-size: 1.4rem;
    line-height: 1.6rem;
    font-weight: var(--font-heading--weight);
    font-style: var(--font-heading--style);
    padding: 2.4rem 0 0;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.6rem;
    width: 100%;
  }

  .bratz-product-info__highlight span.metafield-string {
    font-size: 1.2rem;
    line-height: 1.6rem;
  }

  .bratz-product-info__price {
    flex: 0 0 auto;
    margin: 0;
    white-space: nowrap;
    padding: 1.6rem 0;
  }

  .bratz-product-info__highlight p {
    margin: 0;
  }

  .bratz-product-info__price > div[ref="priceContainer"] {
    display: flex;
    flex-direction: row-reverse;
    justify-content: left;
    gap: 1.6rem;
  }

/* =========================================================
   COLLECTION PRODUCT GRID - MOBILE
   ========================================================= */

@media screen and (max-width: 749px) {

  .bratz-collection-product-card .bratz-product-info {
    display: grid;
    grid-template-columns: 1fr;
    width: 100%;
  }

  .bratz-collection-product-card
  .bratz-product-info__header {
    display: contents;
  }

  .bratz-collection-product-card .bratz-product-info__title {
    grid-column: 1;
    grid-row: 1;
    font-size: 1.6rem;
    padding: 0.5rem 0.7rem;
  }

  .bratz-collection-product-card .bratz-product-info__highlight {
    grid-column: 1;
    grid-row: 2;
    padding: 0 .7rem;
  }

  .bratz-collection-product-card .bratz-product-info__price {
    grid-column: 1;
    grid-row: 3;
    padding: 0 0.7rem 0;
    font-size: 1.6rem;
  }

}

{% endstylesheet %}

{% schema %}
{
  "name": "Product info",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Product info"
    }
  ],
  "presets": [
    {
      "name": "Product info",
      "category": "Product"
    }
  ]
}
{% endschema %}