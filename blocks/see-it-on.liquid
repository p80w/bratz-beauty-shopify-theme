{% liquid
  assign block_settings = block.settings
  assign slideshow_attributes = 'data-bratz-step-one'
%}

<div
  class="see-it-on"
  {{ block.shopify_attributes }}
  style="
    --see-it-on-columns: {{ block_settings.columns }};
    --see-it-on-gap: {{ block_settings.columns_gap }}px;
    --see-it-on-mobile-slide-gap: {{ block_settings.mobile_slide_gap }}px;
  "
>
  {% if block_settings.heading != blank %}
    <div class="see-it-on__header">
      <h2 class="see-it-on__heading h4">
        {{ block_settings.heading }}
      </h2>
    </div>
  {% endif %}

  {% capture slides %}

    {% for i in (1..10) %}
      {% liquid
        assign media_type_key = 'media_' | append: i | append: '_type'
        assign image_key = 'media_' | append: i | append: '_image'
        assign video_key = 'media_' | append: i | append: '_video'
        assign alt_key = 'media_' | append: i | append: '_alt'

        assign media_type = block_settings[media_type_key]
        assign image = block_settings[image_key]
        assign video = block_settings[video_key]
        assign alt_text = block_settings[alt_key]

        assign has_media = false

        if media_type == 'video' and video != blank
          assign has_media = true
        elsif media_type == 'image' and image != blank
          assign has_media = true
        endif
      %}

      {% if has_media %}
        {% capture children %}
          <article class="see-it-on__media">

            {% if media_type == 'video' %}
              {{
                video
                | video_tag:
                  class: 'see-it-on__video',
                  autoplay: true,
                  loop: true,
                  muted: true,
                  controls: false,
                  playsinline: true,
                  preload: 'auto'
              }}

            {% elsif media_type == 'image' %}
              {% render 'image',
                image: image,
                class: 'see-it-on__image',
                alt_text_fallback: alt_text
              %}
            {% endif %}

          </article>
        {% endcapture %}

        {% render 'slideshow-slide',
          index: forloop.index0,
          children: children,
          class: 'see-it-on__slide'
        %}
      {% endif %}
    {% endfor %}

  {% endcapture %}

  {% liquid
    assign media_count = 0

    for i in (1..10)
      assign media_type_key = 'media_' | append: i | append: '_type'
      assign image_key = 'media_' | append: i | append: '_image'
      assign video_key = 'media_' | append: i | append: '_video'

      assign media_type = block_settings[media_type_key]
      assign image = block_settings[image_key]
      assign video = block_settings[video_key]

      if media_type == 'video' and video != blank
        assign media_count = media_count | plus: 1
      elsif media_type == 'image' and image != blank
        assign media_count = media_count | plus: 1
      endif
    endfor
  %}

  {% if media_count > 0 %}
    <div class="see-it-on__carousel">

      {% render 'slideshow',
        class: 'see-it-on__slideshow',
        show_arrows: block_settings.show_arrows,
        icon_style: block_settings.icons_style,
        icon_shape: block_settings.icons_shape,
        infinite: false,
        initial_slide: 0,
        slides: slides,
        slide_count: media_count,
        attributes: slideshow_attributes
      %}

    </div>
  {% endif %}
</div>

{% stylesheet %}

/* =========================================================
   SEE IT ON
   ========================================================= */

.see-it-on {
  width: 100%;
  overflow: hidden;
}


/* =========================================================
   HEADER
   ========================================================= */

.see-it-on__header {
  width: 100%;
  margin-block-end: 1.6rem;
  text-align: left;
}

.see-it-on__heading {
  margin: 0;
  text-transform: uppercase;
}


/* =========================================================
   CAROUSEL
   ========================================================= */

.see-it-on__carousel {
  width: 100%;
  position: relative;
}

.see-it-on__slideshow {
  width: 100%;
  position: relative;
  container-type: inline-size;
  container-name: see-it-on-carousel;
}

.see-it-on__slideshow slideshow-arrows {
  padding-inline: 0;
}

.see-it-on__slideshow .slideshow-control {
  z-index: 5;
}


/* =========================================================
   SLIDES
   ========================================================= */

.see-it-on__slideshow slideshow-slides {
  gap: var(--see-it-on-gap, 4px);
}

@media screen and (min-width: 750px) {
  .see-it-on__slide {
    /*
     * Desktop shows 4 full media items + half of the next item.
     * The 4.5 visible slides include 4 gaps, so each slide uses:
     * (100% - 4 gaps) / 4.5
     */
    width: calc(
      (
        100% -
        (var(--see-it-on-gap) * 4)
      ) / 4.5
    );

    flex: 0 0 calc(
      (
        100% -
        (var(--see-it-on-gap) * 4)
      ) / 4.5
    );

    min-width: 0;
    scroll-snap-align: start;
  }
}


/* =========================================================
   MEDIA
   ========================================================= */

.see-it-on__media {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}


/* =========================================================
   IMAGE
   ========================================================= */

.see-it-on__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}


/* =========================================================
   VIDEO
   ========================================================= */

.see-it-on__video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}


/* =========================================================
   MOBILE
   ========================================================= */

@media screen and (max-width: 749px) {
  .see-it-on__slideshow slideshow-slides {
    gap: var(--see-it-on-mobile-slide-gap, 4px);
    padding-inline: 0;
  }

  .see-it-on__slide {
    /* 3 full media items + half of the 4th item */
    width: calc(
      (
        100% -
        (var(--see-it-on-mobile-slide-gap, 4px) * 3)
      ) / 3.5
    );

    flex: 0 0 calc(
      (
        100% -
        (var(--see-it-on-mobile-slide-gap, 4px) * 3)
      ) / 3.5
    );

    min-width: 0;
    scroll-snap-align: start;
  }
}


/* =========================================================
   REDUCED MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {
  .see-it-on__video {
    animation: none;
  }
}

{% endstylesheet %}


