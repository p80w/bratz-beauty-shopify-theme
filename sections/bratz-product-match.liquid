{% liquid
  assign section_settings = section.settings
  assign collection = section_settings.collection
  assign product_count = section_settings.product_count
%}

<section
  id="BratzProductMatch-{{ section.id }}"
  class="bratz-product-match"
>
  <div
    class="
      bratz-product-match__section
      section
      section--{{ section_settings.section_width }}
      spacing-style
    "
    style="
      {% render 'spacing-style', settings: section_settings %}
      --bratz-match-columns: {{ section_settings.columns }};
      --bratz-match-gap: {{ section_settings.column_gap }}px;
    "
  >

    {%- comment -%}
      BACKGROUND IMAGE
    {%- endcomment -%}

    {% if section_settings.background_image != blank %}
      <div
        class="bratz-product-match__background"
        aria-hidden="true"
      >
        {% render 'image',
          image: section_settings.background_image,
          class: 'bratz-product-match__background-image',
          alt_text_fallback: ''
        %}
      </div>
    {% endif %}

    {%- comment -%}
      CONTENT
    {%- endcomment -%}

    <div class="bratz-product-match__content">

      {% if section_settings.heading != blank %}
        <div class="bratz-product-match__header">
          <h2 class="bratz-product-match__heading h4">
            {{ section_settings.heading }}
          </h2>
        </div>
      {% endif %}

      {% if collection != blank and collection.products_count > 0 %}

        <div class="bratz-product-match__slideshow section section--page-width">

          {%- comment -%}
            SLIDES
          {%- endcomment -%}

          {% capture slides %}

            {% for product in collection.products limit: product_count %}

              <slideshow-slide
                slide-id="BratzProductMatchSlide-{{ section.id }}-{{ product.id }}"
                class="bratz-product-match__slide"
              >

                <article
                  class="bratz-product-match__card"
                  data-product-id="{{ product.id }}"
                >

                  {%- comment -%}
                    PRODUCT MEDIA

                    Image #2 = Default
                    Image #1 = Hover
                  {%- endcomment -%}

                  <a
                    href="{{ product.url }}"
                    class="bratz-product-match__media"
                    aria-label="{{ product.title | escape }}"
                  >

                    {% if product.images.size > 1 %}

                      <div class="bratz-product-match__image-wrapper">

                        {{
                          product.images[1]
                          | image_url: width: 1200
                          | image_tag:
                            class: 'bratz-product-match__image bratz-product-match__image--default',
                            loading: 'lazy',
                            widths: '360, 540, 720, 900, 1200',
                            sizes: '(min-width: 990px) calc(100vw / 4), 80vw',
                            alt: product.title
                        }}

                        {{
                          product.images[0]
                          | image_url: width: 1200
                          | image_tag:
                            class: 'bratz-product-match__image bratz-product-match__image--hover',
                            loading: 'lazy',
                            widths: '360, 540, 720, 900, 1200',
                            sizes: '(min-width: 990px) calc(100vw / 4), 80vw',
                            alt: product.title
                        }}

                      </div>

                    {% elsif product.images.size == 1 %}

                      <div class="bratz-product-match__image-wrapper">

                        {{
                          product.images[0]
                          | image_url: width: 1200
                          | image_tag:
                            class: 'bratz-product-match__image bratz-product-match__image--default',
                            loading: 'lazy',
                            widths: '360, 540, 720, 900, 1200',
                            sizes: '(min-width: 990px) calc(100vw / 4), 80vw',
                            alt: product.title
                        }}

                      </div>

                    {% endif %}

                  </a>

                  {%- comment -%}
                    PRODUCT INFO
                  {%- endcomment -%}

                  <div class="bratz-product-match__info">

                    <h3 class="bratz-product-match__title h5">
                      <a href="{{ product.url }}">
                        {{ product.title }}
                      </a>
                    </h3>

                    {% if product.metafields.p80.product_highlight.value != blank %}
                      <div class="bratz-product-match__highlight">
                        {{ product.metafields.p80.product_highlight.value }}
                      </div>
                    {% endif %}

                    <div class="bratz-product-match__price">

                      {% if product.compare_at_price > product.price %}

                        <span class="bratz-product-match__price-current">
                          {{ product.price | money }}
                        </span>

                        <span class="bratz-product-match__price-compare">
                          {{ product.compare_at_price | money }}
                        </span>

                      {% else %}

                        <span class="bratz-product-match__price-current">
                          {{ product.price | money }}
                        </span>

                      {% endif %}

                    </div>

                    <a
                      href="{{ product.url }}"
                      class="bratz-product-match__button button button-primary"
                    >
                      GET THE LOOK
                    </a>

                  </div>

                </article>

              </slideshow-slide>

            {% endfor %}

          {% endcapture %}

          {% liquid
            assign bratz_slideshow_ref = 'bratzProductMatch-' | append: section.id
          %}

          {% render 'slideshow',
            ref: bratz_slideshow_ref,
            slides: slides,
            show_arrows: false,
            initial_slide: 0,
            slide_count: product_count
          %}

        </div>

      {% else %}

        <div class="bratz-product-match__empty">
          Select a product collection in the theme editor.
        </div>

      {% endif %}

    </div>

  </div>
</section>

{% stylesheet %}

/* =========================================================
   BRATZ PRODUCT MATCH SECTION
   ========================================================= */

.bratz-product-match {
  width: 100%;
  position: relative;
  overflow: hidden;
}

.bratz-product-match__section {
  position: relative;
  width: 100%;
}

.bratz-product-match__background {
  position: absolute;
  inset: 0;
  z-index: 0;
  overflow: hidden;
}

.bratz-product-match__background-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.bratz-product-match__content {
  position: relative;
  z-index: 1;
  width: 100%;
}


/* =========================================================
   HEADER
   ========================================================= */

.bratz-product-match__header {
  width: 100%;
  text-align: center;
  margin-block-end: 3.2rem;
}

.bratz-product-match__heading {
  margin: 0;
}


/* =========================================================
   SLIDESHOW
   ========================================================= */

.bratz-product-match__slideshow {
  width: 100%;
  padding: 0 4.8rem;
}

@media screen and (max-width: 749px) {
  .bratz-product-match__slideshow {
    padding: 0 0 0 1.6rem;
  }
}

.bratz-product-match__slideshow slideshow-container {
  background: transparent;
}

.bratz-product-match__slideshow slideshow-slides {
  gap: var(--bratz-match-gap);

  /* Make all slides stretch to the tallest slide */
  align-items: stretch;
}

.bratz-product-match__slide {
  width: calc(
    (100% - (var(--bratz-match-gap) * (var(--bratz-match-columns) - 1)))
    / var(--bratz-match-columns)
  );

  flex: 0 0 auto;
  min-width: 0;
  scroll-snap-align: start;

  /* Allow the product card to stretch */
  display: flex;
}


/* =========================================================
   PRODUCT CARD
   ========================================================= */

.bratz-product-match__card {
  position: relative;
  width: 100%;

  /* Equal-height card layout */
  display: flex;
  flex-direction: column;
  height: 100%;
}


/* =========================================================
   PRODUCT MEDIA
   ========================================================= */

.bratz-product-match__media {
  display: block;
  width: 100%;
  text-decoration: none;
  overflow: hidden;
}

.bratz-product-match__image-wrapper {
  position: relative;
  width: 100%;
  overflow: hidden;
}

.bratz-product-match__image {
  display: block;
  width: 100%;
  height: auto;
  transition: opacity 0.35s ease;
}

.bratz-product-match__image--default {
  position: relative;
  z-index: 1;
  opacity: 1;
}

.bratz-product-match__image--hover {
  position: absolute;
  inset: 0;
  z-index: 2;
  opacity: 0;
}

.bratz-product-match__media:hover .bratz-product-match__image--default {
  opacity: 0;
}

.bratz-product-match__media:hover .bratz-product-match__image--hover {
  opacity: 1;
}


/* =========================================================
   PRODUCT INFO
   ========================================================= */

.bratz-product-match__info {
  padding: 2.4rem;
  /* Fill the remaining card height */
  flex: 1;

  /* Keep button at the bottom */
  display: flex;
  flex-direction: column;
}

.bratz-product-match__title {
  margin: 0;
  font-size: 1.6rem;
  line-height: 1.2;
}

.bratz-product-match__title a {
  color: inherit;
  text-decoration: none;
}

.bratz-product-match__highlight {
    margin-block-start: .6rem;
    font-size: 1.2rem;
    line-height: 1.6;
}

.bratz-product-match__price {
  display: flex;
  align-items: center;
  gap: .8rem;
  font-size: 1.4rem;
  line-height: 1.4;
  padding: 1.6rem 0;
}

.bratz-product-match__price-compare {
  text-decoration: line-through;
}


/* =========================================================
   GET THE LOOK BUTTON
   ========================================================= */

.bratz-product-match__button {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 100%;

  margin-block-start: auto;

  transition:
    background-color 0.25s ease,
    color 0.25s ease;
}

.bratz-product-match__button:hover {
  opacity: 0.85;
}


/* =========================================================
   EMPTY
   ========================================================= */

.bratz-product-match__empty {
  padding: 4rem;
  text-align: center;
}


/* =========================================================
   TABLET
   ========================================================= */

@media screen and (min-width: 990px) and (max-width: 1200px) {
  .bratz-product-match__section {
    --bratz-match-columns: 3 !important;
  }
}

@media screen and (min-width: 750px) and (max-width: 989px) {
  .bratz-product-match__section {
    --bratz-match-columns: 2 !important;
  }
}


/* =========================================================
   MOBILE
   ========================================================= */

@media screen and (max-width: 749px) {

  .bratz-product-match__section {
    padding: 4.8rem 0;
  }

  .bratz-product-match__slideshow slideshow-slides {
    gap: 0.4rem;
  }

  .bratz-product-match__slide {
    flex: 0 0 calc(100% - 5rem);
    width: calc(100% - 5rem);
  }

  .bratz-product-match__header {
    margin-block-end: 2.4rem;
  }

  .bratz-product-match__slideshow.section.section--page-width {
    display: block;
    padding-left: 1.5rem;
  }

  .bratz-product-match__info {
    padding-block-start: 1rem;
  }

  .bratz-product-match__title {
    font-size: 1.5rem;
  }

  .bratz-product-match__highlight {
    font-size: 1.3rem;
  }

  .bratz-product-match__price {
    font-size: 1.3rem;
  }

  .bratz-product-match__button {
    min-height: 4.4rem;
    padding: 1rem 1.6rem;
    font-size: 1.3rem;
  }

  /*
    Disable image swap on touch devices.
    The second image remains the default image on mobile.
  */
  .bratz-product-match__media:hover .bratz-product-match__image--default {
    opacity: 1;
  }

  .bratz-product-match__media:hover .bratz-product-match__image--hover {
    opacity: 0;
  }
}


/* =========================================================
   REDUCED MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

  .bratz-product-match__image {
    transition: none;
  }

  .bratz-product-match__button {
    transition: none;
  }
}

{% endstylesheet %}

{% schema %}

{
  "name": "Bratz Product Match",

  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find Your Perfect Match"
    },

    {
      "type": "collection",
      "id": "collection",
      "label": "Product collection"
    },

    {
      "type": "range",
      "id": "product_count",
      "label": "Product count",
      "min": 1,
      "max": 16,
      "step": 1,
      "default": 4
    },

    {
      "type": "range",
      "id": "columns",
      "label": "Desktop columns",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4
    },

    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 4
    },

    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },

    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full"
        }
      ],
      "default": "full-width"
    },

    {
      "type": "header",
      "content": "Spacing"
    },

    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },

    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },

    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },

    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],

  "presets": [
    {
      "name": "Bratz Product Match"
    }
  ]
}

{% endschema %}